  "additional_criteria_requirements": [
    "Has a performance status of 0 or 1 on the ECOG Performance Scale obtained within 72 hours prior to the first dose of study intervention.",
    "Exclusion: Has had chemotherapy, definitive radiation, or biological cancer therapy within 4 weeks (2 weeks for palliative radiation) prior to first dose of study intervention or has not recovered to CTCAE Grade 1 or better.",
    "Exclusion: Has received prior therapy with anti-PD-1/PD-L1 agents, T-VEC or any other oncolytic virus therapies.",
    "Exclusion for cohort E - Gastric Carcinoma: Has squamous cell or undifferentiated gastric cancer."
  ],
  "trial_id": "NCT04521621",
  "long_title": "A Phase 1b/2 Clinical Study of Intratumoral Administration of V937 in Combination with Pembrolizumab (MK-3475) in Participants with Advanced/Metastatic Solid Tumors",
  "protocol_no": "013-04",
  "short_title": "Phase 1b/2 Study of ITu V937 in Combination with Pembrolizumab",
  "phase": "I",
  "nct_purpose": "This study will evaluate the safety, tolerability, and preliminary efficacy of V937  administration in combination with pembrolizumab in 2 arms: Arm 1 includes subcutaneously-accessible tumors (Arm 1), while Arm 2 includes tumors with  visceral metastases.",
