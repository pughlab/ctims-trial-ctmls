            "arm_additional_criteria_not_captured": [
              {
                "additional_criteria_requirement_name": "HCC: Has advanced HCC following progression on, or intolerance to, sorafenib or lenvatinib with no curative options."
              },
              {
                "additional_criteria_requirement_name": "HCC: Has diagnosis of HCC confirmed by radiology, histology, or cytology (fibrolamellar and mixed hepatocellular/cholangiocarcinoma subtypes not eligible for enrollment). Radiologic diagnosis is defined as: evidence of liver cirrhosis and a liver mass measuring at least 1 cm with characteristic vascularization (intense enhancement in hepatic arterial-dominant phase and contrast washout in late portal venous phase) on triphasic CT or MRI scan."
              },
              {
                "additional_criteria_requirement_name": "HCC: Has Child-Pugh Class A score"
              },
              {
                "additional_criteria_requirement_name": "HCC: If a participant has a history of HCV infection, then the participant must have been successfully treated for this condition, which is defined as SVR12."
              },
              {
                "additional_criteria_requirement_name": "HCC: If participant has a known history of chronic hepatitis B infection and/or exposure and has received treatment with anti-hepatitis B therapy. "
              },
              {
                "additional_criteria_requirement_name": "Gastric Carcinoma: Has histologically- or cytologically-confirmed diagnosis of locally-advanced, unresectable or metastatic gastric or GEJ adenocarcinoma: a. must have received at least one prior line of therapy that includes a platinum/fluoropyrimidine doublet or triplet regimen. Progression can be confirmed by CT or PET/CT scan or clinical evidence (eg, cytology report from ascites and/or pleural fluid). "
              },
              {
                "additional_criteria_requirement_name": "Gastric Carcinoma: b. must have proven clinical progression 6 months following (or during) last dose of adjuvant or neo-adjuvant therapy provided participant previously received a platinum/fluoropyrimidine doublet."
              },
              {
                "additional_criteria_requirement_name": "Gastric Carcinoma: Participants with HER2 negative status; or, those with HER2 positive status AND documented disease progression on a prior regimen containing trastuzumab. Note: HER2 negative is defined as IHC (0, or 1+) or fluorescence in situ hybridization (FISH) negative (HER2:CEP17 ratio <2 with average HER2 copy number <4.0 signals/cell)"
              }
            ],
